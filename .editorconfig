# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go — tabs are the canonical style (gofmt uses tabs)
[*.go]
indent_style = tab
indent_size = 2

# go.mod / go.sum / go.work
[go.{mod,sum,work}]
indent_style = tab

# Markdown — two trailing spaces are a hard line break, don't strip them
[*.md]
trim_trailing_whitespace = false

# Makefiles require real tabs
[Makefile]
indent_style = tab
